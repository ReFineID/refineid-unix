# Pre-commit gate: refuse commits that introduce unformatted Rust.
# cargo fmt --check parses only, so it is ~1s and needs no system
# libraries. The full build / test / clippy gate stays in
# script/check.sh, run before pushing.
#
# Installed by script/install-githook.sh (sets core.hooksPath).

set -eu

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not on PATH; enter the dev shell (nix develop) first" >&2
    exit 1
fi

if ! cargo fmt --all --check; then
    echo >&2
    echo "pre-commit: unformatted Rust. Run 'cargo fmt --all' and stage the result." >&2
    exit 1
fi
